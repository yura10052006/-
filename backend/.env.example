# --- Скопіюй у .env і впиши свої ключі. .env у git НЕ потрапляє. ---

# Anthropic (Claude). Взяти на console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (для Whisper STT). Взяти на platform.openai.com
OPENAI_API_KEY=sk-...

# Todoist API token. Todoist -> Settings -> Integrations -> Developer -> API token
TODOIST_TOKEN=...

# Спільний секрет клієнт<->бекенд (X-App-Token). Придумай будь-який довгий рядок.
APP_SHARED_TOKEN=changeme-put-a-long-random-string-here

# Модель Claude. Haiku 4.5 -- швидко/дешево. Резерв: claude-sonnet-5
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Мова STT (ISO-639-1)
STT_LANGUAGE=uk
