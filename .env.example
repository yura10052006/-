# Скопіюйте цей файл у ".env" і впишіть свої значення.
# Copy this file to ".env" and fill in your values.

# Токен Telegram-бота від @BotFather (обовʼязково для реального запуску в Telegram).
# Telegram bot token from @BotFather (required for real Telegram launch).
BOT_TOKEN=

# Порт, на якому працює сервер / Port the server listens on.
PORT=3000

# Режим розробки: 1 = дозволити відкривати додаток у звичайному браузері без Telegram.
# Dev mode: 1 = allow opening the app in a normal browser without Telegram.
# У продакшені поставте 0! / Set to 0 in production!
DEV_MODE=1

# Публічна HTTPS-адреса додатку (для налаштування кнопки бота).
# Public HTTPS URL of the app (used to set the bot menu button).
WEBAPP_URL=
